# Gemini API key for the AI beta features (AI 일정 채우기 / 프로젝트 검토하기).
# Server-side only — never prefix with NEXT_PUBLIC_, never read from client code.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project used for anonymous usage analytics (src/lib/analytics.ts).
# Public by design (anon key, read via NEXT_PUBLIC_ from the browser) — RLS on
# analytics_events should allow inserts only, no reads, for the anon role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production domain (no trailing slash), e.g. https://to-do-line.com.
# Used for SEO metadata (src/lib/seo/site.ts): metadataBase/canonical/OG URLs
# and the sitemap link in robots.txt. Leave empty until the domain is set —
# metadata falls back to relative URLs, and the sitemap directive is omitted.
NEXT_PUBLIC_SITE_URL=
