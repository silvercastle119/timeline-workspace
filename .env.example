# Gemini API key for the AI beta features (AI 일정 채우기 / 프로젝트 검토하기).
# Server-side only — never prefix with NEXT_PUBLIC_, never read from client code.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project used for anonymous usage analytics (src/lib/analytics.ts).
# Public by design (anon key, read via NEXT_PUBLIC_ from the browser) — RLS on
# analytics_events should allow inserts only, no reads, for the anon role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= 
